# VC Composer 2 website: every environment variable the code reads.
#
# Copy to .env.local for local development, and set the same names in Vercel
# (Project Settings > Environment Variables). Nothing is read at build time
# except NEXT_PUBLIC_* values, which Next inlines into the browser bundle; the
# site builds with none of these set. A missing server key fails only the
# feature that needs it (e.g. checkout), at the moment it is used.
#
# Never commit real values. NEXT_PUBLIC_* values are public by design; every
# other value here is a secret.

# --- Site -------------------------------------------------------------------
# The site's own origin, with scheme and no trailing slash. Used in Stripe
# redirects, emailed links and Open Graph metadata. Defaults to
# https://vc-composer.com when unset or malformed.
NEXT_PUBLIC_SITE_URL=https://vc-composer.com

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket holding the installers (created by migration 0003).
RELEASE_BUCKET=releases
# How long a signed installer URL stays valid, in seconds.
RELEASE_DOWNLOAD_TTL_SECONDS=900

# --- Stripe (shared account; this site acts only on metadata.product=vc-composer)
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Recurring price ids for the two plans. Amounts are read live from Stripe.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend.
RESEND_FROM_ADDRESS=VC Composer <noreply@vc-composer.com>

# --- Cloudflare Turnstile (sign-in CAPTCHA) ----------------------------------
# Until TURNSTILE_SECRET_KEY is set the check is skipped; the rate limit still applies.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting ------------------------------------------------------------
# Salt for the keyed hash of client addresses in public.rate_limits. Any long
# random string; changing it only resets the current windows.
RATE_LIMIT_SALT=

# -----------------------------------------------------------------------------
# Not read by the website. Used only by scripts/publish-release.mjs, run from
# a terminal or CI to upload an installer (see docs/deployment.md):
#   SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...
#   RELEASE_BUCKET=releases                (optional)
#   SUPABASE_STORAGE_URL=                  (optional; derived from SUPABASE_URL)
#
# Only for tests: EMAIL_PREVIEW_DIR=/some/dir writes the rendered email HTML.
